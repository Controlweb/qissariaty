# Copy to .dev.vars for local development (git-ignored).
# Client-side vars belong in .env as VITE_MAPBOX_TOKEN=pk...
# Optional abuse protection (P0 scale): when set, register/login must include
# a Turnstile token which the Worker verifies. Leave empty for local dev.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production secrets (never commit): wrangler secret put TURNSTILE_SECRET_KEY
